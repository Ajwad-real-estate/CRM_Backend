import { getPool } from "../../configs/dbConfig.js";


const getUserDataById = async (req, res) => {
    const AgentId = req.params.id;
    if (!AgentId) {
        return res.status(400).json({ message: "Agent Id is required." });
    }

    const pool = await getPool();
    try {
        const fetchAgentById = `SELECT * FROM agent WHERE id = $1;`;

        const { rows } = await pool.query(fetchAgentById, [AgentId]);

        if (rows.length === 0) {
            return res.status(404).json({ message: "Agent not found." });
        }

        res.status(200).json(rows[0]);
    } catch (error) {
        console.error("Error fetching Agent:", error);
        res.status(500).json({ message: "Internal server error." });
    }
};



// Modified update user endpoint to handle status_id
const updateUserDataById = async (req, res) => {
    const userId = req.params.id;
    const user = req.body;

    if (!userId) {
        return res.status(400).json({ message: "Invalid user ID." });
    }

    if (!user || Object.keys(user).length === 0) {
        return res.status(400).json({ message: "No fields provided to update." });
    }

    try {
        const pool = await getPool();

        // First, verify that the status_id exists if it's being updated
        if (user.status_id) {
            const statusCheck = await pool.query(
                'SELECT id FROM agent_status WHERE id = $1',
                [user.status_id]
            );

            if (statusCheck.rowCount === 0) {
                return res.status(400).json({
                    message: "Invalid status_id. The specified status does not exist."
                });
            }
        }

        // Exclude "id" and "created_at" from the update
        const excludeFields = ["id", "created_at"];
        const filteredUser = Object.keys(user)
            .filter((key) => !excludeFields.includes(key))
            .reduce((obj, key) => {
                obj[key] = user[key];
                return obj;
            }, {});

        if (Object.keys(filteredUser).length === 0) {
            return res.status(400).json({ message: "No valid fields to update." });
        }

        // Dynamically build the SET clause
        const setClause = Object.keys(filteredUser)
            .map((key, index) => `${key} = $${index + 1}`)
            .join(", ");

        const values = [...Object.values(filteredUser), userId];

        const updateUserQuery = `
            UPDATE agent
            SET ${setClause}
            WHERE id = ${values.userId}
            RETURNING id, name, email, street, status_id, role_id, target;
        `;

        const result = await pool.query(updateUserQuery, values);

